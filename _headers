# Cache-Control for static assets. GitHub Pages served everything with a
# fixed max-age=600 and no way to change it; this is the part of that
# problem Cloudflare actually fixes.
#
# Anything not listed keeps the Workers default:
#   Cache-Control: public, max-age=0, must-revalidate  (plus an ETag)
# which is what HTML wants. A game page's content depends on ?s=, and its
# link preview is rewritten per state, so it must never be served stale.

# Vendored fonts are pinned to a version and would be replaced under a new
# name, never edited in place, so they can be cached forever. This rule is
# safe to keep broad: .woff2 matches neither of the rules below.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# assets/vendor/ deliberately has NO rule of its own. It used to carry the same
# immutable line, but /assets/vendor/lz-string.min.js also matches /*.js below and
# the two rules did not override — they concatenated, producing
#   public, max-age=31536000, immutable, public, max-age=600, ...
# which is ambiguous: parsers disagree on whether the first or last max-age
# wins. lz-string is 4.8 KiB, so letting the /*.js rule own it costs a
# revalidation every ten minutes, and stale-while-revalidate means no page
# load ever waits for it. Worth more than a header nobody can predict.

# The link-preview image. WhatsApp and friends fetch it every time a link is
# shared; letting repeat fetches be answered from cache shaves a round trip
# off the preview card. A day is short enough that a changed image still
# propagates promptly (the file name carries no hash).
/og-image.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Letter Boxed's word list (about 115 KB gzipped, fetched only on that page). A day
# is short enough for a changed list to propagate; stale-while-revalidate keeps
# repeat visits from ever waiting on it.
/letter-boxed/words.txt
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The site's own CSS and JS have no hash in their file NAMES, but every page asks for them as file.js?v=<hash of the
# file> (tests/cache-bust.mjs stamps them; the cache-versions check fails on a stale stamp). A changed file therefore
# has a new address, so an old address can be cached for a year: nothing waits on a revalidation after the first visit.
# The query string is part of the cache key, which is why a rule on the bare path is safe.
#
# RULE: never load a script or stylesheet without a ?v= stamp, or a phone keeps the old copy for a year.
# (sw.js is the one exception: the Worker answers it with its own no-cache header, see worker/index.mjs.)
/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

# The hub's art sprite is asked for as hub-art.svg?v=<hash> (stamped like the scripts), so it is immutable too.
/assets/hub-art.svg
  Cache-Control: public, max-age=31536000, immutable

# Pictures keep their names when they change, so a day plus background refresh.
/battleship/ships/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# iPhone launch screens: only fetched when the installed app starts.
/assets/splash/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

# The Worker also answers on its workers.dev hostname, which serves the
# same site as wa-minigames.online. Keep search engines off that copy so
# the real domain is the only one indexed — these rules are scoped by
# hostname, so they never touch the custom domain.
https://wa-minigames.cwakiku.workers.dev/*
  X-Robots-Tag: noindex

# Same for the per-version preview URLs wrangler hands out on deploy.
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
